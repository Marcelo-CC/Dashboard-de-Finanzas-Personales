{
  "name": "dashboard-finanzas-api",
  "version": "1.0.0",
  "description": "API REST del Dashboard de Finanzas Personales (G0203) - Node.js, Express y MongoDB",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "demo": "cross-env DATA_DRIVER=memory node src/server.js",
    "seed": "node src/scripts/seed.js",
    "test": "cross-env NODE_ENV=test node --test --test-reporter=spec \"tests/**/*.test.js\"",
    "demo:seguridad": "node src/scripts/securityDemo.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dayjs": "^1.11.23",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-jwt": "^8.5.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.13.0",
    "nodemailer": "^10.6.1",
    "uuid": "^14.0.3",
    "validator": "^13.15.35"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "supertest": "^7.3.2"
  }
}
