# ---------- Servidor ----------
PORT=3000
NODE_ENV=development
# URL del frontend (CORS y enlace de recuperación de contraseña)
CLIENT_URL=http://localhost:5173
# Zona horaria del negocio ("hoy" y "mes actual"). Las fechas se guardan en UTC.
APP_TIMEZONE=America/Lima

# ---------- Persistencia ----------
# mongo = MongoDB Atlas / local (producción) | memory = datos en memoria para demo sin base de datos
DATA_DRIVER=mongo
MONGODB_URI=mongodb+srv://USUARIO:CLAVE@cluster0.xxxxx.mongodb.net/dashboard_finanzas?retryWrites=true&w=majority

# ---------- Seguridad (JWT) ----------
# Cambiar por una cadena larga y aleatoria
JWT_SECRET=cambia-esta-clave-por-una-cadena-larga-y-aleatoria
JWT_EXPIRES_IN=1h

# ---------- Correo (recuperación de contraseña) ----------
# Si SMTP_HOST está vacío, el enlace se imprime en la consola del servidor (modo desarrollo)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=tu_correo@gmail.com
# En Gmail: usar una "Contraseña de aplicación", no la contraseña normal
SMTP_PASS=
MAIL_FROM="Dashboard de Finanzas <tu_correo@gmail.com>"
RESET_TOKEN_MINUTES=30
